<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store package manifest for the Windows client.

  pack.ps1 fills the three placeholder fields from the Partner Center identity
  and the release version, then packs this next to Hiroba.exe (the bare tauri
  build output; no installer) with makeappx. The Store signs the result on
  upload, so nothing is signed here. What the MSI does through the registry
  (the hiroba:// scheme, the Add/Remove Programs entry) the manifest declares
  instead, and the app detects the package at runtime (store_managed in
  lib.rs) to leave updates to the Store.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!-- Name and Publisher are assigned by Partner Center when the app name is
       reserved (Product management → Product identity) and must match it
       exactly; the Store rejects the upload otherwise. Version is the release
       tag plus a fourth component, and the Store requires it to grow with
       every submission. -->
  <Identity
    Name="@@IDENTITY_NAME@@"
    Publisher="@@PUBLISHER@@"
    Version="@@VERSION@@"
    ProcessorArchitecture="x64" />

  <Properties>
    <!-- Both DisplayNames must equal a name reserved for the product in
         Partner Center. "Hiroba" alone was already reserved by someone else,
         so the Store install is "Hiroba Office" (the Start menu shows this);
         the window title and the MSI keep "Hiroba". -->
    <DisplayName>Hiroba Office</DisplayName>
    <!-- Must equal the publisher display name of the Partner Center account. -->
    <PublisherDisplayName>Ludo Technologies LLC</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 = Windows 10 1809, the oldest release with MSIX. The WebView2
         runtime is not declared: it ships with Windows 11 and reached
         Windows 10 through Windows Update, and MSIX has no hook to install
         it the way the MSI's bootstrapper does. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- The Store shows these as the product's supported languages, so keep
       them equal to LOCALES in i18n.ts (the app picks its language from the
       OS regardless). Partner Center lists each of them under "Languages
       supported in packages" and expects a Store listing per language; a
       language without a translated listing is removed there and falls back
       to the English listing. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="ja-JP" />
    <Resource Language="es" />
    <Resource Language="fr" />
  </Resources>

  <Applications>
    <Application Id="Hiroba" Executable="Hiroba.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Hiroba Office"
        Description="Lightweight open-source virtual office for remote teams"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- hiroba://auth/<code> sign-in handoffs (deeplink.ts). The OS starts
             Hiroba.exe with the URL as its argument, the same path the MSI's
             registry entry takes. -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="hiroba">
            <uap:DisplayName>Hiroba</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A packaged Win32 app: the binary runs outside the AppContainer, which
         is what lets the keychain, the OAuth loopback listener and the tray
         icon work unchanged. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
