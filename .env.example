# Configuration for compose.yaml. Copy to .env and edit.

# Hostname this office is reached at. Caddy obtains a certificate for it, so
# its DNS record must point at this host and ports 80/443 must be reachable.
HIROBA_DOMAIN=hiroba.example.com

# Your org: id (lowercase, no spaces) and the name shown atop the roster.
HIROBA_ORG=acme
HIROBA_ORG_NAME=Acme

# Anything else from docs/SELF_HOSTING.md §4–6 goes here too, e.g. TURN:
# HIROBA_TURN_URL=turn:turn.example.com:3478
# HIROBA_TURN_SECRET=...
